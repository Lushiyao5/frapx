{
  "name": "@frapx/glsl-noise",
  "version": "0.3.0",
  "description": "Lightweight GLSL noise helpers for frapx fragment shaders: simplex, Perlin, fBm and curl noise.",
  "keywords": [
    "webgl",
    "shader",
    "glsl",
    "noise",
    "perlin",
    "simplex",
    "fbm",
    "curl"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kramhash/frapx.git",
    "directory": "packages/glsl-noise"
  },
  "homepage": "https://kramhash.github.io/frapx/packages/glsl-noise/",
  "bugs": {
    "url": "https://github.com/kramhash/frapx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
