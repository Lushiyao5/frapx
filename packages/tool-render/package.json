{
  "name": "@frapx/tool-render",
  "version": "0.3.0",
  "description": "Node CLI that renders a @frapx/tool-capture page frame by frame in headless Chrome — resumable PNG sequences on disk, with optional ProRes or H.264 encoding through ffmpeg.",
  "keywords": [
    "webgl",
    "shader",
    "render",
    "cli",
    "png-sequence",
    "offline-rendering",
    "ffmpeg"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "frapx-render": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@frapx/fx-canvas": "workspace:*",
    "@frapx/tool-capture": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kramhash/frapx.git",
    "directory": "packages/tool-render"
  },
  "homepage": "https://kramhash.github.io/frapx/packages/tool-render/",
  "bugs": {
    "url": "https://github.com/kramhash/frapx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
